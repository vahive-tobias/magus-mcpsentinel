# Generate long, unique values. Never commit the real .dev.vars file.
OPERATOR_API_KEY=replace-with-a-local-operator-key
# Signs reports posted to /api/reports, by an external analyzer or by hand.
ANALYZER_INGEST_SECRET=replace-with-a-long-random-secret

# Set to "false" to stop this Worker analyzing releases itself, so it only detects
# them and something else does the work — the hybrid pipeline. Workers Free handles
# ordinary packages fine; this is for packages above the plan's ceiling. See the
# measured table in README.md.
# ANALYZE_IN_WORKER=false

# Enables GET /api/pending for an external analyzer. Without it that route does
# not exist. Deliberately not OPERATOR_API_KEY: an analyzer reads pending work and
# submits reports, and should not be able to create targets or accept notices.
# ANALYZER_POLL_KEY=replace-with-a-third-long-random-secret

# Email delivery, via Resend. All three are required together; with any missing,
# a notice is recorded as 'not_configured' rather than silently unsent.
# NOTIFY_FROM must be on a domain verified in your Resend account.
# RESEND_API_KEY=re_your_key
# NOTIFY_FROM=watch@yourdomain.example
# NOTIFY_TO=you@yourdomain.example

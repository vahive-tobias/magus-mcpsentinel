# Generate long, unique values. Never commit the real .dev.vars file.
OPERATOR_API_KEY=replace-with-a-local-operator-key
ANALYZER_INGEST_SECRET=replace-with-a-long-random-secret
JOB_SIGNING_SECRET=replace-with-a-second-long-random-secret
# Leave empty in local MVP mode. Set this to the authenticated Sentinel adapter URL
# once an analyzer service has been deployed.
ANALYZER_URL=

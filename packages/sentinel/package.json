{
  "name": "mcp-sentinel",
  "version": "0.2.0",
  "description": "Deterministic, non-executing evidence reports for public npm MCP servers.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vahive-tobias/magus-mcpsentinel.git",
    "directory": "packages/sentinel"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "sentinel": "dist/src/cli.js"
  },
  "//exports": "Only portable modules are exported, so a consumer in a constrained runtime can import them. ./analyze is the single analysis entry point; the filesystem-backed variants, the CLI and the internal module layout stay unexported so they remain free to change.",
  "exports": {
    "./analyze": {
      "types": "./dist/src/analyze.d.ts",
      "default": "./dist/src/analyze.js"
    },
    "./diff": {
      "types": "./dist/src/diff.d.ts",
      "default": "./dist/src/diff.js"
    },
    "./report-contract": {
      "types": "./dist/src/report-contract.d.ts",
      "default": "./dist/src/report-contract.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/src",
    "schemas",
    "README.md"
  ],
  "scripts": {
    "build": "npm run generate && tsc -p tsconfig.json && node scripts/copy-generated.mjs",
    "generate": "node scripts/generate-validator.cjs && node scripts/generate-build-info.mjs",
    "test": "npm run build && node --test dist/test/*.test.js",
    "start": "node dist/src/cli.js"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "acorn": "^8.18.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}

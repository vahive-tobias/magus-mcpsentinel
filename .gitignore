# ---- Build output ----
dist/
*.tsbuildinfo

# ---- Dependencies ----
node_modules/

# ---- Cloudflare ----
.wrangler/

# ---- Internal working documents ----
# Kept locally so we can track our own work; not part of the published repo.
# This repository distributes a tool. It is not a record of how it was built.
docs/ENGINEERING_LOG.md
docs/ENGINEERING_LOG_WATCH.md
docs/ROADMAP.md
docs/PRODUCT_AND_TECHNICAL_PLAN.md
docs/FIXTURE_PLAN.md
docs/Project Sentinel.md
docs/SECURITY_WATCH_NOTES.md
docs/PLAN_*.md

# Published deliberately, despite living under docs/.
!docs/change-reports/
!docs/change-reports/**

# ---- Third-party specification snapshot ----
# Not redistributed. docs/SPEC_PROVENANCE.md records the source, retrieval date
# and SHA-256 of each document so the pinned profile stays reproducible.
docs/MCP-specs-2026-07-28/

# Regenerated on every watch run as the review pull request's body. The baselines
# beside it are the state worth keeping; this is not.
.sentinel-watch/notice.md

# ---- Research notes pasted from third-party sources ----
# Other people's specification text, kept for reference while assessing it. Not
# ours to redistribute, and not a claim this project makes.
docs/Agent Plugin manifest.txt

# ---- Internal working notes ----
# This repository is public. CLAUDE.md carries pricing strategy, revenue targets
# and the owner's own position; it is not a document to publish by accident.
CLAUDE.md

# ---- Build-time generated sources ----
# Both are rebuilt by `npm run build` before tsc runs, and both are derived
# entirely from committed inputs: build-info.ts from the analyzer sources,
# report-validator from schemas/report.schema.json. Committing them would let a
# stale copy disagree with the code it claims to describe.
packages/sentinel/src/build-info.ts
packages/sentinel/src/generated/

# ---- Analyzer output ----
# Reports and preserved acquisition evidence are generated artifacts. They can
# contain the full contents of a third-party package and must never be committed.
reports/
evidence/
*.tgz
*.tar.gz

# ---- Deployment configuration that identifies a real Cloudflare account ----
# The committed wrangler.toml keeps the placeholder database_id. Deploy from a
# private copy instead, so the real identifiers never sit in a public repository.
# They are identifiers rather than credentials, but they link this repo to an
# account, and `npm run deploy` uses this file.
wrangler.private.toml
packages/*/wrangler.private.toml

# ---- Secrets and local configuration ----
# A local record of secrets that were installed on a deployed Worker. Worker
# secrets are write-only, so this is the only copy.
*.secrets.local
# .dev.vars holds the operator API key and both HMAC secrets.
# .npmrc can hold a registry auth token.
.dev.vars
.dev.vars.*
!.dev.vars.example
.npmrc
.env
.env.*
!.env.example
*.pem
*.key

# ---- Local data ----
*.sqlite
*.sqlite3
*.db

# ---- Logs and coverage ----
*.log
npm-debug.log*
coverage/
.nyc_output/

# ---- Editors ----
.vscode/
.idea/
*.swp
*~

# ---- OS ----
.DS_Store
._*
Thumbs.db
desktop.ini
